SECRET_KEY=dev-secret-key

# RTO / vehicle lookup API
RTO_API_URL=https://your-rto-provider.example/api
RTO_API_PROVIDER=your-provider-name
RTO_API_KEY=your-api-key
RTO_API_CLIENT_ID=your-client-id
RTO_API_CLIENT_SECRET=your-client-secret
RTO_API_TIMEOUT=10

# Optional LLM OCR
LLM_OCR_ENABLED=False
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=20

# OCR thresholds
OCR_CONFIDENCE_THRESHOLD=0.45

# Optional dedicated plate detector model
PLATE_MODEL_PATH=
