SECRET_KEY=dev-secret-key

# RTO / vehicle lookup API
RTO_API_URL=https://your-rto-provider.example/api
RTO_API_PROVIDER=your-provider-name
RTO_API_KEY=your-api-key
RTO_API_CLIENT_ID=your-client-id
RTO_API_CLIENT_SECRET=your-client-secret
RTO_API_TIMEOUT=10

# CarInfo Authorized API Configuration
CARINFO_API_URL=https://api.carinfo.app/v1/vehicle/details
CARINFO_API_KEY=
CARINFO_API_SECRET=
CARINFO_API_TOKEN=
CARINFO_TEST_MODE=true
VEHICLE_API_CACHE_SECONDS=300


# Optional LLM OCR
LLM_OCR_ENABLED=False
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=20

# OCR thresholds
OCR_CONFIDENCE_THRESHOLD=0.45

# Dedicated License Plate YOLO Model Path
VEHICLE_MODEL_PATH=yolov8n.pt
PLATE_MODEL_PATH=models/license_plate_detector.pt
PLATE_CONFIDENCE_THRESHOLD=0.35

# Stage 6 & 7: Multi-Frame Tracker & Stream Performance Configurations
TRACKER_MIN_OBSERVATIONS=3
TRACKER_CONFIDENCE_THRESHOLD=0.45
TRACKER_TIMEOUT_SECONDS=10.0
MAX_DUPLICATE_SECONDS=15
FRAME_SKIP_INTERVAL=2
CAMERA_RECONNECT_INTERVAL=3.0
MAX_FRAME_QUEUE_SIZE=2
RTSP_TIMEOUT_MS=3000
VIDEO_SAMPLE_INTERVAL=2
VIDEO_ANALYZE_INTERVAL=5

